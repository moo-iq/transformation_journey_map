        <object label="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;u&gt;&lt;b&gt;People support efficiency by:&lt;/b&gt;&lt;/u&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul style=&quot;padding-left: 20px; margin-top: 10px; margin-bottom: 0px;&quot;&gt;&lt;li&gt;Safety health ergonomics&lt;/li&gt;&lt;li&gt;An individual wellbeing&lt;/li&gt;&lt;li&gt;A high motivation and morale&lt;/li&gt;&lt;li&gt;Short learning cycles (time 2 learn)&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" label_de="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;u&gt;&lt;b&gt;Menschen unterstützen Effizienz durch:&lt;/b&gt;&lt;/u&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul style=&quot;padding-left: 20px; margin-top: 10px; margin-bottom: 0px;&quot;&gt;&lt;li&gt;Gesundheitsergonomie&lt;/li&gt;&lt;li&gt;Individuelles Wohlbefinden&lt;/li&gt;&lt;li&gt;Hohe Motivation und Arbeitsmoral&lt;/li&gt;&lt;li&gt;Kurze Lernzyklen (time 2 learn)&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" id="NPktaMn14VHzqkv4nWxG-56">
