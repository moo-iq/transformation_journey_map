        <mxCell id="NPktaMn14VHzqkv4nWxG-57" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;u&gt;&lt;b&gt;Delivery of outcome to customers:&lt;/b&gt;&lt;/u&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul style=&quot;padding-left: 20px; margin-top: 10px; margin-bottom: 0px;&quot;&gt;&lt;li&gt;Single outputs grow to a product&lt;/li&gt;&lt;li&gt;Short time to market for outcome&lt;/li&gt;&lt;li&gt;Deliver a product that meets the customer needs&lt;/li&gt;&lt;li&gt;Transparency and feedback about delivery performance&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=1;points=[];autosize=0;strokeColor=none;fillColor=none;fontSize=20;fontFamily=Helvetica;fontColor=default;whiteSpace=wrap;" parent="AcFJhxBT_vqd_4cILIRe-1" vertex="1">
