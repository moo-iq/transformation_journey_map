  <diagram id="hLXF8po-ixmmLyeViBxV" name="Experience Journey">
    <mxGraphModel dx="3370" dy="2216" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3300" pageHeight="2339" background="#EDEDED" backgroundImage="{&quot;src&quot;:&quot;data:image/svg+xml;base64,&quot;,&quot;width&quot;:3207,&quot;height&quot;:2292.39,&quot;x&quot;:47,&quot;y&quot;:47,&quot;originalSrc&quot;:&quot;data:page/id,zIa-P5VTieIrH3UptsYF&quot;}" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" value="Base Structure" style="" parent="0" />
        <object label="&lt;font style=&quot;font-size: 40px;&quot;&gt;Experience Journey&lt;/font&gt;" label_de="&lt;font style=&quot;font-size: 40px;&quot;&gt;Change Design Canvas&lt;/font&gt;" id="2YPV1KAfdtGkDiZaIfRB-2">
          <mxCell style="text;html=1;strokeColor=none;fillColor=#f2f2f2;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#000000;fontFamily=Verdana;fontSize=40;fontStyle=1;spacingLeft=10;spacing=0;" parent="1" vertex="1">
            <mxGeometry x="53" y="53" width="724" height="114" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="2YPV1KAfdtGkDiZaIfRB-1" value="Info on journey" style="" parent="0" />
        <mxCell id="MW1EOghh0jO6Moxi7gZK-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.509;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;exitX=0.509;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;strokeColor=#d6b656;strokeWidth=10;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=none;fillColor=#fff2cc;" parent="2YPV1KAfdtGkDiZaIfRB-1" source="MW1EOghh0jO6Moxi7gZK-2" target="MW1EOghh0jO6Moxi7gZK-3" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="375" y="530" />
              <mxPoint x="375" y="530" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="MW1EOghh0jO6Moxi7gZK-2" value="&lt;b&gt;&lt;u&gt;Grow individuals to grow the organization&lt;/u&gt;&lt;/b&gt;&lt;br style=&quot;border-color: var(--border-color); font-size: 20px;&quot;&gt;&lt;ol style=&quot;border-color: var(--border-color); font-size: 20px;&quot;&gt;&lt;li style=&quot;border-color: var(--border-color); font-size: 20px;&quot;&gt;The experience journey is linked to the concept of learning experience canvas&lt;/li&gt;&lt;li style=&quot;border-color: var(--border-color); font-size: 20px;&quot;&gt;A basic idea of the concept is to grow the individual competence in a systematic way to grow the overall team&lt;/li&gt;&lt;/ol&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=10;spacingTop=12;fontFamily=Verdana;fontSize=20;align=left;spacing=16;" parent="2YPV1KAfdtGkDiZaIfRB-1" vertex="1">
          <mxGeometry x="80" y="200" width="540" height="230" as="geometry" />
        </mxCell>
        <mxCell id="MW1EOghh0jO6Moxi7gZK-3" value="&lt;u style=&quot;font-weight: bold;&quot;&gt;The Experience Journey Map&lt;/u&gt;&lt;br&gt;&lt;b&gt;&lt;i&gt;Flow of the journey&lt;br&gt;&lt;/i&gt;&lt;/b&gt;Our map describes 4 major phases within the journey. Each phase levels up the state of mind.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;border-color: var(--border-color);&quot;&gt;&lt;i style=&quot;border-color: var(--border-color);&quot;&gt;A phase describes the environment&lt;br style=&quot;border-color: var(--border-color);&quot;&gt;&lt;/i&gt;&lt;/b&gt;The environment of the team can also be understood as maturity level, it is a constraint for the journey and influence the strategy to move forward." style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Verdana;align=left;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=10;spacingTop=12;spacing=16;" parent="2YPV1KAfdtGkDiZaIfRB-1" vertex="1">
          <mxGeometry x="80" y="490" width="540" height="310" as="geometry" />
        </mxCell>
        <mxCell id="MW1EOghh0jO6Moxi7gZK-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeColor=#6c8ebf;strokeWidth=10;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=none;fillColor=#dae8fc;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="2YPV1KAfdtGkDiZaIfRB-1" source="MW1EOghh0jO6Moxi7gZK-3" target="MW1EOghh0jO6Moxi7gZK-6" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="369.78" y="840" as="sourcePoint" />
            <mxPoint x="345" y="865" as="targetPoint" />
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="MW1EOghh0jO6Moxi7gZK-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#82b366;strokeWidth=10;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=none;fillColor=#d5e8d4;" parent="2YPV1KAfdtGkDiZaIfRB-1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="345" y="1200" />
              <mxPoint x="345" y="1200" />
            </Array>
            <mxPoint x="345" y="1120" as="sourcePoint" />
            <mxPoint x="320" y="1180" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="MW1EOghh0jO6Moxi7gZK-6" value="&lt;b style=&quot;text-decoration: underline;&quot;&gt;Focus on the outcome of learning&lt;/b&gt;&lt;br&gt;In the design of the experience journey the &lt;b&gt;focus on the desired outcome&lt;/b&gt; is crucial. Use tools such as &lt;i&gt;empathy maps&lt;/i&gt; or the &lt;i&gt;map of inner state&lt;/i&gt;.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Starting from the current state it is essential to &lt;b&gt;design the future state&lt;/b&gt; to explain the outcome achieved.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=10;spacingTop=12;fontSize=20;align=left;spacing=16;" parent="2YPV1KAfdtGkDiZaIfRB-1" vertex="1">
          <mxGeometry x="80" y="860" width="540" height="260" as="geometry" />
        </mxCell>
        <mxCell id="MW1EOghh0jO6Moxi7gZK-7" value="&lt;u style=&quot;border-color: var(--border-color); font-weight: bold;&quot;&gt;Measure key results not indicators&lt;/u&gt;&lt;br style=&quot;border-color: var(--border-color);&quot;&gt;For your stakeholder and participant communication it will become crucial to create transparency over the achievements and changes.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;At this point focus on the objectives and their key results. The result is the deviation of the indicator, not the indicator itself.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;The overall growth in the maturity is more important than specific measure of activities. See the maturity map.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Verdana;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=10;spacingTop=12;align=left;spacing=16;" parent="2YPV1KAfdtGkDiZaIfRB-1" vertex="1">
          <mxGeometry x="80" y="1180" width="540" height="350" as="geometry" />
        </mxCell>
        <mxCell id="NqPBxEISqRj0U3yjGr-f-1" value="Set of relevant skills, experience &amp;amp;&lt;br&gt;practices for teams and individuals" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#F5DEAA;shape=mxgraph.archimate3.capability;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="2YPV1KAfdtGkDiZaIfRB-1">
