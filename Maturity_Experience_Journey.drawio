        <mxCell id="a-0zBgfOTpgdiLpWHztL-60" value="Within our learning organization we adapt with ease" style="rounded=1;whiteSpace=wrap;html=1;rotation=15;fillColor=light-dark(#B1E3E7,#009999);opacity=60;fillStyle=hatch;glass=0;strokeColor=none;shadow=0;backgroundOutline=0;sketch=1;curveFitting=1;jiggle=2;fontFamily=Verdana;fontSize=24;fontStyle=1;textShadow=1;textOpacity=50;" parent="a-0zBgfOTpgdiLpWHztL-24" vertex="1">
