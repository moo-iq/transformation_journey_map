        <mxCell id="NPktaMn14VHzqkv4nWxG-53" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;u&gt;&lt;b&gt;The organization strives towards:&lt;/b&gt;&lt;/u&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul style=&quot;padding-left: 20px; margin-top: 10px; margin-bottom: 0px;&quot;&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;The leadership and people adapt&lt;br&gt;&lt;/span&gt;to changing environments&lt;/li&gt;&lt;li&gt;The organization &quot;breath&quot; and leverage technology&lt;/li&gt;&lt;li&gt;People and teams feel safe and valuable&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=1;points=[];autosize=0;strokeColor=none;fillColor=none;fontSize=20;connectable=0;allowArrows=0;expand=0;resizeHeight=1;resizeWidth=1;overflow=hidden;recursiveResize=1;whiteSpace=wrap;" parent="AcFJhxBT_vqd_4cILIRe-1" vertex="1">
          <mxGeometry x="515" y="371" width="355" height="190" as="geometry" />
        </mxCell>
        <mxCell id="NPktaMn14VHzqkv4nWxG-54" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;u&gt;&lt;b&gt;Leaders &amp;amp; People develop towards:&lt;/b&gt;&lt;/u&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul style=&quot;padding-left: 20px; margin-top: 10px; margin-bottom: 0px;&quot;&gt;&lt;li&gt;Take charge to drive things forward&lt;/li&gt;&lt;li&gt;Understand own state &amp;amp; contribution&lt;/li&gt;&lt;li&gt;Support each other for growth&lt;/li&gt;&lt;li&gt;Knowing their value for the organization&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=1;points=[];autosize=0;strokeColor=none;fillColor=none;fontSize=20;fontFamily=Helvetica;fontColor=default;whiteSpace=wrap;" parent="AcFJhxBT_vqd_4cILIRe-1" vertex="1">
          <mxGeometry x="880" y="371" width="350" height="190" as="geometry" />
        </mxCell>
        <mxCell id="NPktaMn14VHzqkv4nWxG-55" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;u&gt;&lt;b&gt;The organization drives value by:&lt;/b&gt;&lt;/u&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul style=&quot;padding-left: 20px; margin-top: 10px; margin-bottom: 0px;&quot;&gt;&lt;li&gt;Constantly creating customer satisfaction&lt;/li&gt;&lt;li&gt;Sustainably created solutions&lt;/li&gt;&lt;li&gt;Understanding of customer needs&lt;/li&gt;&lt;li&gt;Providing validated solutions regularly&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=1;points=[];autosize=0;strokeColor=none;fillColor=none;fontSize=20;fontFamily=Helvetica;fontColor=default;whiteSpace=wrap;" parent="AcFJhxBT_vqd_4cILIRe-1" vertex="1">
          <mxGeometry x="1244" y="371" width="350" height="190" as="geometry" />
        </mxCell>
        <mxCell id="NPktaMn14VHzqkv4nWxG-56" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;u&gt;&lt;b&gt;People support efficiency by:&lt;/b&gt;&lt;/u&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul style=&quot;padding-left: 20px; margin-top: 10px; margin-bottom: 0px;&quot;&gt;&lt;li&gt;Safety health ergonomics&lt;/li&gt;&lt;li&gt;An individual wellbeing&lt;/li&gt;&lt;li&gt;A high motivation and morale&lt;/li&gt;&lt;li&gt;Short learning cycles (time 2 learn)&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=1;points=[];autosize=0;strokeColor=none;fillColor=none;fontSize=20;fontFamily=Helvetica;fontColor=default;whiteSpace=wrap;" parent="AcFJhxBT_vqd_4cILIRe-1" vertex="1">
